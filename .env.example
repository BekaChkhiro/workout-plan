# Copy to .env.local for local dev. Set the real values in the Vercel dashboard
# (Project → Settings → Environment Variables) for Preview + Production.

# --- Database (Neon Postgres, T1.5) ---
# Pooled connection — used by the running app (serverless / edge).
DATABASE_URL=postgresql://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/DB?sslmode=require
# Unpooled connection — required by drizzle-kit migrations (no pgbouncer).
DATABASE_URL_UNPOOLED=postgresql://USER:PASSWORD@HOST.REGION.aws.neon.tech/DB?sslmode=require

# --- Auth (Lucia, T3.x) ---
# Generate with: openssl rand -base64 32
AUTH_SECRET=replace-me-with-openssl-rand-base64-32

# --- Web Push (T6.4) ---
# Generate with: npx web-push generate-vapid-keys
# Public key is also exposed to the browser via NEXT_PUBLIC_VAPID_PUBLIC_KEY.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
NEXT_PUBLIC_VAPID_PUBLIC_KEY=

# --- Vercel Blob (T5.x — progress photos) ---
# Created via Vercel dashboard → Storage → Blob.
BLOB_READ_WRITE_TOKEN=
