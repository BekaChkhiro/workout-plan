# Environment template — copy to `.env.local` and fill in real values.
# In Vercel, set the same vars in Project Settings → Environment Variables
# (Production + Preview + Development as appropriate).

# --- Database (T1.5: Neon Postgres) ---
# Pooled connection string — used by app runtime (serverless / edge).
DATABASE_URL=
# Direct (unpooled) connection — used by drizzle-kit migrations and seed scripts.
DATABASE_URL_UNPOOLED=

# --- Auth (T3.x: Lucia / session secret) ---
# Random 32+ byte secret. Generate with: openssl rand -base64 32
AUTH_SECRET=

# --- Web Push / VAPID (T6.4) ---
# Generate with: npx web-push generate-vapid-keys
# Server-side: signs push payloads.
VAPID_PRIVATE_KEY=
VAPID_PUBLIC_KEY=
# Client-side: passed to PushManager.subscribe({ applicationServerKey }).
# Must be the same public key as VAPID_PUBLIC_KEY (mirrored for browser exposure).
NEXT_PUBLIC_VAPID_PUBLIC_KEY=

# --- Vercel Blob (T7.x: progress photo storage) ---
# Read/write token from Vercel dashboard → Storage → Blob.
BLOB_READ_WRITE_TOKEN=
